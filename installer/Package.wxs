<?xml version="1.0" encoding="utf-8"?>

<!-- The installer: the server alone, into the person's profile (offered first) or Program Files.
     Nothing is checked before it and nothing is fetched after it. Built by installer.ps1. -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Remote Game Hub"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="91DDC640-BBAE-4574-9FC1-A8389087E1EE"
           Scope="perUserOrMachine"
           Compressed="yes">

    <!-- One file in one cab inside the msi: there is nothing to stream separately. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- An older version is replaced, not added beside: two copies would fight over the ports. The
         same version counts as an upgrade too, or a rebuild of the same number would leave both. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Remote Game Hub is already installed." />

    <!-- Windows 11 x64 only, checked before anything is copied. The build comes from the registry:
         WindowsBuild and VersionNT lie to an msi (9600 and 603 on a build-28000 machine). -->
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000"
            Message="Remote Game Hub needs 64-bit Windows 11 or newer. This machine does not meet that, and nothing has been installed." />

    <Icon Id="AppIcon.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrey-lysikov/remote-gamehub" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Where to put it: the dialog stands on these two, offering the person's profile first. The
         questions need no administrator rights; the driver and the server ask when reached. -->
    <Property Id="ApplicationFolderName" Value="Remote-Gamehub" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Remote-Gamehub" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Where the server keeps its configuration either way (AppConfig.FallbackDirectory). Named
         only so the virtual-display checkbox can put one setting there ahead of the first run. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CONFIGFOLDER" Name="Remote-Gamehub" />
    </StandardDirectory>

    <!-- "Just me" would otherwise land in AppData\Local\Apps. The server falls back to
         AppData\Local\Remote-Gamehub for its files, so the exe goes there too: one place for all. -->
    <SetProperty Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]Remote-Gamehub"
                 After="WixSetDefaultPerUserFolder"
                 Sequence="both" />

    <!-- And "for everyone" would otherwise land in Program Files (x86): ProgramFilesFolder means
         the 32-bit one even in a 64-bit package. This server is x64 and belongs in the real one. -->
    <SetProperty Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder]Remote-Gamehub"
                 After="WixSetDefaultPerMachineFolder"
                 Sequence="both" />

    <!-- Whether the server is already here, and in which of the two places: Windows Installer says
         a related product exists but never where. Only read once an upgrade has been detected. -->
    <Property Id="PERMACHINECOPY" Secure="yes">
      <DirectorySearch Id="PerMachineFolderSearch" Path="[ProgramFiles64Folder]Remote-Gamehub">
        <FileSearch Id="PerMachineExeSearch" Name="Remote-Gamehub.exe" />
      </DirectorySearch>
    </Property>

    <Property Id="PERUSERCOPY" Secure="yes">
      <DirectorySearch Id="PerUserFolderSearch" Path="[LocalAppDataFolder]Remote-Gamehub">
        <FileSearch Id="PerUserExeSearch" Name="Remote-Gamehub.exe" />
      </DirectorySearch>
    </Property>

    <!-- An upgrade keeps the scope it finds: changed halfway, it leaves two servers on one pair of
         ports, since neither scope can remove the other. AppSearch at 50 settles this in time. -->
    <SetProperty Action="SetPerMachineUpgrade" Id="WixAppFolder" Value="WixPerMachineFolder"
                 After="AppSearch" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND PERMACHINECOPY" />

    <!-- Program Files wins when both are somehow there — the state this rule exists to stop. It is
         the copy an elevated install can actually replace, and the one nobody can clear by hand. -->
    <SetProperty Action="SetPerUserUpgrade" Id="WixAppFolder" Value="WixPerUserFolder"
                 After="AppSearch" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND PERUSERCOPY AND NOT PERMACHINECOPY" />

    <!-- What the scope page would have published: the stock actions at 998 and 999 read ALLUSERS
         and Privileged and nothing else, while WixAppFolder above only dresses the pages. -->
    <SetProperty Action="SetAllUsersForUpgrade" Id="ALLUSERS" Value="1"
                 After="SetPerMachineUpgrade" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND PERMACHINECOPY" />

    <!-- Cleared rather than left at 2, which the stock pair reads as "an administrator, so Program
         Files": an upgrade of a copy in the profile must stay there whoever runs it. -->
    <SetProperty Action="ClearAllUsersForUpgrade" Id="ALLUSERS" Value="{}"
                 After="SetPerUserUpgrade" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND PERUSERCOPY AND NOT PERMACHINECOPY" />

    <!-- A first install goes into the profile too; the stock set would decide Program Files for
         anybody elevated. A scope named on the command line is left alone. -->
    <SetProperty Action="ClearAllUsersForFirstInstall" Id="ALLUSERS" Value="{}"
                 After="ClearAllUsersForUpgrade" Sequence="both"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND ALLUSERS=2" />

    <!-- The folder the two above cannot name: Windows Installer knows where it put the component
         last time, whichever of the two folders — or a third, browsed to — it went into. -->
    <Property Id="INSTALLEDFOLDER" Secure="yes">
      <ComponentSearch Id="InstalledServerSearch"
                       Guid="F7D96560-E799-4DE3-ADDD-C7085743FF44" Type="directory" />
    </Property>

    <!-- Named outright, so the pair at 998 and 999 stand down: both ask for an empty
         APPLICATIONFOLDER. When the search finds nothing they carry on off the scope above. -->
    <SetProperty Action="SetUpgradeFolder" Id="APPLICATIONFOLDER" Value="[INSTALLEDFOLDER]"
                 After="ClearAllUsersForFirstInstall" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND INSTALLEDFOLDER" />

    <?define ShortcutName = "Remote Game Hub" ?>
    <?define ShortcutNote = "Game and desktop streaming to Moonlight clients" ?>

    <!-- The server is a single exe. Everything it needs beyond .NET comes with the display
         driver. -->
    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExe" Guid="F7D96560-E799-4DE3-ADDD-C7085743FF44">
        <File Id="RemoteGameHubExe" Source="$(Exe)" Name="Remote-Gamehub.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Directly in the menu: one entry deserves no folder. Not advertised, which would show no
         icon unless named in the msi and drag the repair machinery in for a single file. -->
    <ComponentGroup Id="StartMenuShortcutFiles" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7751937F-1686-474E-BBB6-701852521CDF">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]Remote-Gamehub.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <!-- A shortcut cannot be a key path, so the mark of the component lives in the registry,
             under the user who asked for it. -->
        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutFiles" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B5077057-1950-40B9-A649-FCFFD37BE524">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]Remote-Gamehub.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- What the shortcuts-page checkbox asks for: not the driver, only the setting that makes the
         server look for one. addLine creates the file; the first run then rewrites it whole. -->
    <ComponentGroup Id="VirtualDisplayConfigFiles" Directory="CONFIGFOLDER">
      <Component Id="VirtualDisplayConfig" Guid="7FC65322-E599-43EA-A41B-55472499DA5C">
        <IniFile Id="SetVirtualDisplay" Action="addLine" Directory="CONFIGFOLDER"
                 Name="Remote-Gamehub.conf" Section="General" Key="VirtualDisplay" Value="true" />

        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="VirtualDisplaySetting"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The two checkboxes, on by default, as features rather than component conditions: a feature
         left out is remembered as left out, while a condition would be re-evaluated at removal. -->
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- Ticked to begin with: the client's pads are what most people stream games for. Neither
         driver is installed from here — a ticked box opens the page it is published on. -->
    <Property Id="INSTALLVIGEM" Value="1" />

    <!-- Off to begin with: a virtual display is a thing to go looking for rather than something
         most people want, and ticking it also turns the setting on in the configuration file. -->
    <Property Id="INSTALLVDD" Value="0" />

    <Feature Id="Main"
             Title="Remote Game Hub"
             Description="The server itself."
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="AppFiles" />

      <Feature Id="StartMenu" Title="Start menu shortcut"
               Description="A shortcut in the Start menu." Level="1">
        <ComponentGroupRef Id="StartMenuShortcutFiles" />
        <Level Value="0" Condition="INSTALLSTARTMENUSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="Desktop" Title="Desktop shortcut"
               Description="A shortcut on the desktop." Level="1">
        <ComponentGroupRef Id="DesktopShortcutFiles" />
        <Level Value="0" Condition="INSTALLDESKTOPSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="VirtualDisplaySetting" Title="Virtual display driver"
               Description="Turns on [General] VirtualDisplay in the configuration file." Level="1">
        <ComponentGroupRef Id="VirtualDisplayConfigFiles" />
        <Level Value="0" Condition="INSTALLVDD &lt;&gt; 1" />
      </Feature>

    </Feature>

    <!-- Removes the service the server makes for itself (App/ServiceControl.cs), which is also
         what frees the exe: the service and its SYSTEM worker have no window a close could reach. -->
    <CustomAction Id="RemoveService"
                  Directory="APPLICATIONFOLDER"
                  ExeCommand="&quot;[#RemoteGameHubExe]&quot; uninstall-service"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- A running copy holds the ports and the exe, has no window for a close message and runs
         elevated, so it is asked from the elevated side and then ended. -->
    <util:CloseApplication Id="CloseRunningServer"
                           Target="Remote-Gamehub.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no"
                           Timeout="10" />

    <!-- "Start with Windows" is a scheduled task the server makes from its tray menu, named after
         the product (App/Autostart.cs). Removed here on uninstall; a failure is not worth stopping. -->
    <CustomAction Id="RemoveAutostartTask"
                  Directory="APPLICATIONFOLDER"
                  ExeCommand="[System64Folder]schtasks.exe /delete /tn &quot;Remote Game Hub&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Before RemoveFiles, on uninstall and on the removal half of an upgrade. Losing the service
           in an upgrade costs nothing: the new server makes it again at its first start. -->
      <Custom Action="RemoveService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- On a real uninstall only: an upgrade removes the older version with REMOVE=ALL as well, and
           UPGRADINGPRODUCTCODE is set on exactly that removal and on no other. -->
      <Custom Action="RemoveAutostartTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- The advanced set is the one that asks whom the install is for, and brings the folder page
         with it: for everyone or for me, and where it goes. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

    <!-- Starts the server when the installer closes, unless the checkbox says otherwise. Through
         the shell, so the elevation prompt appears, and as the person installing, not elevated. -->
    <Property Id="LAUNCHAFTERINSTALL" Value="1" />

    <CustomAction Id="SetAppTarget" Property="WixShellExecTarget" Value="[#RemoteGameHubExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <!-- All either driver checkbox does: the driver's own page, opened through the shell as the
         person installing, so it lands in the browser they are already signed into. -->
    <CustomAction Id="SetViGEmTarget" Property="WixShellExecTarget"
                  Value="https://github.com/nefarius/ViGEmBus/releases/latest" />
    <CustomAction Id="OpenViGEmPage" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <CustomAction Id="SetVddTarget" Property="WixShellExecTarget"
                  Value="https://github.com/VirtualDrivers/Virtual-Display-Driver/releases" />
    <CustomAction Id="OpenVddPage" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <!-- Our shortcuts page, between the folder page and the last one. The tens in Ordering put
         ours after the stock jumps (one to seven), and the later of two next-dialogs decides. -->
    <UI>
      <!-- The stock set skips the folder page for a per-user install; that half is claimed here, so
           both ways reach the folder and the shortcuts behind it. -->
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" Order="10" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />

      <!-- On an upgrade neither the scope nor the folder is a question, so "Advanced" passes both
           pages. The stock jumps out of the first page are ordered one to three. -->
      <Publish Dialog="AdvancedWelcomeEulaDlg" Control="Advanced" Event="NewDialog"
               Value="ShortcutsDlg" Condition="WIX_UPGRADE_DETECTED" Order="20" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog"
               Value="AdvancedWelcomeEulaDlg" Condition="WIX_UPGRADE_DETECTED" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <!-- The way back is claimed only while installing: during maintenance the last page returns
           to the repair-or-remove page, and a page about shortcuts has nothing to say then. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg"
               Condition="NOT Installed" Order="10" />

      <!-- Only after a fresh install: the same page ends a repair and an uninstall too. The stock
           event that closes the page sits at 999, so both of these run before it. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetAppTarget"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed" Order="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed" Order="2" />

      <!-- One page per ticked box, each set and then opened. They share WixShellExecTarget, so
           the order matters: the pair for a page has to run before the pair for the next one. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetViGEmTarget"
               Condition="INSTALLVIGEM = 1 AND NOT Installed" Order="3" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenViGEmPage"
               Condition="INSTALLVIGEM = 1 AND NOT Installed" Order="4" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetVddTarget"
               Condition="INSTALLVDD = 1 AND NOT Installed" Order="5" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenVddPage"
               Condition="INSTALLVDD = 1 AND NOT Installed" Order="6" />
    </UI>
  </Package>
</Wix>
