<?xml version="1.0" encoding="utf-8"?>

<!-- Our one dialog, between the stock folder page and the last one: where the shortcuts go. The
     geometry (370 x 270, banner, buttons) follows the stock dialogs so the page does not jump. -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts and start" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="Where to put [ProductName], and whether to start it." />

        <Control Id="StartMenuCheckBox" Type="CheckBox" X="20" Y="55" Width="330" Height="15"
                 Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1"
                 Text="Add a shortcut to the Start menu" />

        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="71" Width="330" Height="15"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="Add a shortcut to the desktop" />

        <!-- The same question the stock last page can ask, asked here instead: there the checkbox
             comes out in a grey box of its own; here it sits on the same ground as the two above. -->
        <Control Id="LaunchCheckBox" Type="CheckBox" X="20" Y="87" Width="330" Height="15"
                 Property="LAUNCHAFTERINSTALL" CheckBoxValue="1"
                 Text="Start the server when the installer finishes" />

        <!-- What presents the client's gamepads to games. Fetched by Prerequisites.ps1, not
             carried in this package — see DRIVERSWITCH. -->
        <Control Id="ViGEmCheckBox" Type="CheckBox" X="20" Y="103" Width="330" Height="15"
                 Property="INSTALLVIGEM" CheckBoxValue="1"
                 Text="Install the ViGEmBus virtual controller driver" />

        <!-- Off by default, and the driver is never fetched: checking this opens its page and turns
             on [General] VirtualDisplay so the server looks for it once installed. -->
        <Control Id="VddCheckBox" Type="CheckBox" X="20" Y="119" Width="330" Height="15"
                 Property="INSTALLVDD" CheckBoxValue="1"
                 Text="Open the virtual display driver's page, and use one once it is installed" />

        <Control Id="Note" Type="Text" X="20" Y="137" Width="330" Height="62" Transparent="yes"
                 NoPrefix="yes"
                 Text="The server lives in the notification area: it has no window of its own, and a shortcut is what starts it the first time. Its tray menu can make it start with Windows from then on. What the server needs and does not carry — the .NET runtime, and the driver above — is fetched or installed when the installer finishes, and only if it is missing or out of date." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
