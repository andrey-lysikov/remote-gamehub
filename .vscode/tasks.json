{
  // Building on macOS for Windows 11. Every publish switch (win-x64, single file, framework
  // dependent) is already in the csproj; Directory.Build.props lets the SDK target Windows here.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Debug build of the server, win-x64, into src/bin",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/RemoteGameHub.csproj",
        "-c", "Debug",
        "--nologo"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "publish",
      "detail": "Release exe for Windows 11 x64 into build/Remote-Gamehub.exe, as build.ps1 does",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/RemoteGameHub.csproj",
        "-c", "Release",
        "-o", "${workspaceFolder}/build",
        "--nologo"
      ],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "build tests",
      "detail": "Compiles the tests only: they need the Windows runtime to run, so run them on Windows",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/test/RemoteGameHub.Tests.csproj",
        "-c", "Release",
        "--nologo"
      ],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "restore",
      "detail": "Fetches the packages and the Windows targeting pack; needed once, and after a csproj change",
      "type": "shell",
      "command": "dotnet",
      "args": ["restore", "${workspaceFolder}/RemoteGameHub.sln"],
      "problemMatcher": []
    },
    {
      "label": "clean",
      "detail": "Removes bin and obj under src and test; build/ is left alone, it holds user files",
      "type": "shell",
      "command": "rm",
      "args": [
        "-rf",
        "${workspaceFolder}/src/bin", "${workspaceFolder}/src/obj",
        "${workspaceFolder}/test/bin", "${workspaceFolder}/test/obj"
      ],
      "problemMatcher": []
    }
  ]
}
